{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "small_model": "ollama/gemma4:e4b#fast",
  "providers": {
    "ollama": {
      "name": "Ollama",
      "settings": {
      },
      "models": {
        "qwen3.5:4b": {
          "name": "Qwen 3.5 4B",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "body": {
            "think": true
          },
          "variants": [
            {
              "id": "fast",
              "body": {
                "temperature": 0.1,
                "think": false
              }
            }
          ]
        },
        "gemma4:e4b": {
          "name": "Gemma 4 E4B",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "body": {
            "think": true
          },
          "variants": [
            {
              "id": "fast",
              "body": {
                "temperature": 0.1,
                "think": false
              }
            }
          ]
        },
        "deepseek-r1:8b": {
          "name": "DeepSeek R1 8B",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "body": {
            "think": true
          },
          "variants": [
            {
              "id": "fast",
              "body": {
                "temperature": 0.1,
                "think": false
              }
            }
          ]
        }
      }
    }
  },
  "agents": {
    "orchestrator": {
      "description": "Analista e orquestrador Cloud. Planeja, decompõe em microtarefas sequenciais e audita o executor local.",
      "mode": "primary",
      "permissions": [
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "local-worker",
          "effect": "allow"
        }
      ]
    },
    "local-worker": {
      "description": "Executor local enxuto. Executa uma única microtarefa por vez e retorna status padronizado.",
      "mode": "subagent",
      "model": "ollama/gemma4:e4b#fast",
      "steps": 15,
      "permissions": [
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
