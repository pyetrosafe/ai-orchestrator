{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ollama": {
      "name": "Ollama",
      "settings": {
      },
      "models": {
        "qwen3.5:4b": {
          "name": "Qwen 3.5 4B",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 32768,
            "output": 16384
          },
          "body": {
            "think": true
          },
          "variants": [
            {
              "id": "fast",
              "body": {
                "temperature": 0.1,
                "think": false
              }
            }
          ]
        },
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 32768,
            "output": 16384
          },
          "body": {
            "think": true
          },
          "variants": [
            {
              "id": "fast",
              "body": {
                "temperature": 0.1,
                "think": false
              }
            }
          ]
        },
        "gemma4:e4b": {
          "name": "Gemma 4 E4B",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 32768,
            "output": 16384
          },
          "body": {
            "think": true
          },
          "variants": [
            {
              "id": "fast",
              "body": {
                "temperature": 0.1,
                "think": false
              }
            }
          ]
        },
        "gemma4:12b": {
          "name": "Gemma 4 12B",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 32768,
            "output": 16384
          },
          "body": {
            "think": true
          },
          "variants": [
            {
              "id": "fast",
              "body": {
                "temperature": 0.1,
                "think": false
              }
            }
          ]
        }
      }
    }
  },
  "agents": {
    "orchestrator": {
      "description": "Cloud analyst and orchestrator. Plans work, decomposes it into sequential microtasks, and audits the local executor.",
      "mode": "primary",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm test *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm run lint *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm run build *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "pytest *",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "local-worker",
          "effect": "allow"
        }
      ]
    },
    "local-worker": {
      "description": "Lean local executor. Executes one microtask at a time and returns a standardized status.",
      "mode": "subagent",
      "model": "ollama/qwen3.5:9b#fast",
      "steps": 30,
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git reset --hard *",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
